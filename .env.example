# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com/apis/credentials
# Add your redirect URI under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redirect URI must exactly match what is registered in Google Cloud Console.
# For local dev:
OAUTH_REDIRECT_URI=http://localhost:8501

# ── Role assignment ───────────────────────────────────────────────────────────
# Comma-separated list of email addresses that receive the "reviewer" role.
# Everyone else is a "viewer".
REVIEWER_EMAILS=alice@example.com,bob@example.com

# Alternatively (or additionally), grant the reviewer role to all users whose
# email belongs to one of these domains.
REVIEWER_DOMAINS=mycompany.com

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Defaults to http://localhost:11434 if not set.
# OLLAMA_HOST=http://localhost:11434
# WORKBENCH_LLM_MODEL=llama3.1:latest
